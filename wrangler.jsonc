{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wacns-github-io",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve /404.html (with a 404 status) for any path that doesn't exist
    "not_found_handling": "404-page"
  }
}
